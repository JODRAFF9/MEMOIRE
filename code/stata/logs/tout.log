. di _newline ">>> Copie des figures vers latex/figures et Presentation/figures ..."

>>> Copie des figures vers latex/figures et Presentation/figures ...

. /* Copie dynamique de tous les PDF generes (toute figure future incluse)
>    vers le rapport ET la presentation Beamer, pour les garder synchronises. */
. local figs : dir "$OUTPUT/figures" files "*.pdf"

. foreach f of local figs {
  2.     foreach dest in "latex/figures" "Presentation/figures" {
  3.         capture copy "$OUTPUT/figures/`f'" "`dest'/`f'", replace
  4.         if _rc di "    !! echec copie `f' vers `dest' (rc=" _rc ")"
  5.     }
  6.     di "    ok `f'"
  7. }
    ok fig_carte_nmoda_barres.pdf
    ok fig_croisement_pauvrete.pdf
    ok fig_dd_trajectoires.pdf
    ok fig_dim_0_4.pdf
