. di "  Part de faux traites appliquee : " %6.4f `part_fake'
  Part de faux traites appliquee : 0.1328

. 
. forvalues r = 1/`n_rep' {
  2.     quietly {
  3.         use `liste_men', clear
  4.         set seed `=1000+`r''
  5.         gen u = runiform()
  6.         sort u
  7.         gen byte fakeD = (_n <= `part_fake'*`n_men')
  8.         keep grappe menage fakeD
  9.         tempfile fake
 10.         save `fake'
 11. 
.         use `never', clear
 12.         merge m:1 grappe menage using `fake', keep(match) nogenerate
 13. 
.         /* DD placebo (moyennes des 4 cellules) */
.         foreach y in pauvre_MODA {
 14.             summarize `y' if t==1 & fakeD==1
 15.             local m11 = r(mean)
 16.             summarize `y' if t==0 & fakeD==1
 17.             local m01 = r(mean)
 18.             summarize `y' if t==1 & fakeD==0
 19.             local m10 = r(mean)
 20.             summarize `y' if t==0 & fakeD==0
 21.             local m00 = r(mean)
 22.             local att = (`m11'-`m01') - (`m10'-`m00')
 23.             matrix PLA[`r',1] = `att'
 24.         }
 25.     }
 26.     if mod(`r', 50) == 0 di "  replication `r'/`n_rep'"
 27. }
  replication 50/200
  replication 100/200
  replication 150/200
  replication 200/200

