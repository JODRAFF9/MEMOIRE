. /* ── Sensibilite au seuil inter-dimensionnel k ──────────────────
>    Le seuil k=4 est une convention. On reestime l'ATT en definissant la
>    pauvrete successivement a chaque seuil de 1 a 7 dimensions sur 7, pour
>    verifier que la conclusion ne depend pas du seuil retenu. */
. di _newline "=== Sensibilite de l'ATT au seuil de privation k ==="

=== Sensibilite de l'ATT au seuil de privation k ===

. di "  k        ATT      SE       p"
  k        ATT      SE       p

. forvalues k = 1/7 {
  2.     quietly gen byte pauvre_k`k' = (nb_dep >= `k') if !missing(nb_dep)
  3.     quietly regress pauvre_k`k' i.t##i.D [aw=$POIDS_PRINCIPAL], vce(cluster grappe)
  4.     quietly lincom 1.t#1.D
  5.     di "  " %1.0f `k' %11.4f r(estimate) %9.4f r(se) %8.4f r(p)
  6.     quietly drop pauvre_k`k'
  7. }
