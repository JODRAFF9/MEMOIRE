=== Appariement Kernel (Epanechnikov, h=0.06), par groupe d'age ===

. tempfile ker_all

. local premier = 1

. forvalues g = 1/3 {
  2.     use "$TEMP/pscore_t0.dta", clear
  3.     keep if grp_psm == `g'
  4.     di _newline "-- Groupe d'age `g' --"
  5.     psmatch2 D, pscore(pscore) kernel kerneltype(epan) bwidth(0.06) common
  6. 
.     di _newline "Balance avant/apres (SMD), kernel, groupe `g' :"
  7.     pstest `covbal', both
  8.     quietly _biaismoyen $BALVARS, treat(D) pond(_weight)
  9.     global BIAIS_kernel = ${BIAIS_kernel} + r(meanbias)*_N
 10.     global NOBS_kernel  = ${NOBS_kernel}  + _N
 11.     di "  Biais standardise moyen residuel, groupe `g' : " %5.2f r(meanbias) " %"
 12. 
.     rename _weight weight_kernel
 13.     keep enfid weight_kernel
 14.     if `premier' == 1 {
 15.         save `ker_all', replace
 16.         local premier = 0
 17.     }
 18.     else {
 19.         append using `ker_all'
 20.         save `ker_all', replace
 21.     }
