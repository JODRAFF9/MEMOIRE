  dim_eau18           0.191     0.247    -0.056   0.0554
  dim_logem18         0.588     0.704    -0.116   0.0001
  dim_nutri18         0.526     0.748    -0.222   0.0000
  dim_sante18         0.962     0.983    -0.022   0.0291
  dim_protect18       0.406     0.493    -0.088   0.0000
