=== H, A et M0 par groupe d'age (periode de base) et statut ===

. forvalues g = 1/3 {
  2.     local titg : label grp `g'
  3.     di "  -- `titg' --"
  4.     forvalues d = 0/1 {
  5.         forvalues tt = 0/1 {
  6.             quietly summarize pauvre_MODA if D == `d' & t == `tt' & groupe_base == `g'
  7.             local H = r(mean)
  8.             quietly summarize intensite_moda ///
>                 if D == `d' & t == `tt' & groupe_base == `g' & pauvre_MODA == 1
  9.             local A = r(mean)
 10.             di "    D=`d' t=`tt' :  H = " %6.3f `H' ///
>                "   A = " %6.3f `A' "   M0 = " %6.3f `H'*`A'
 11.         }
 12.     }
 13. }
