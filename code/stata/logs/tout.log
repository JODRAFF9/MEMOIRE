. /* Croisement genre du chef de menage x statut de beneficiaire x vague, pour
>    l'ensemble des enfants puis pour chaque tranche d'age. Alimente le
>    tableau par genre de chaque sous-section descriptive. */
. forvalues g = 0/3 {
  2.     if `g' == 0 local lbl "Ensemble 0-17 ans"
  3.     if `g' == 1 local lbl "0-4 ans"
  4.     if `g' == 2 local lbl "5-14 ans"
  5.     if `g' == 3 local lbl "15-17 ans"
  6.     di _newline(2) "=== Incidence MODA par genre du chef et statut — `lbl' ==="
  7.     di "  Chef        D=0 2018  D=1 2018   Ecart |  D=0 2021  D=1 2021   Ecart |     DD    p18    p21      n18  
>     n21"
  8.     forvalues sx = 1/2 {
  9.         local slbl = cond(`sx' == 1, "Chef homme", "Chef femme")
 10.         if `g' == 0 local cond "hgender == `sx'"
 11.         else        local cond "hgender == `sx' & groupe_base == `g'"
 12.         quietly summarize pauvre_MODA [aw=hhweight] if t == 0 & D == 0 & `cond'
 13.         local a0 = r(mean)*100
 14.         quietly summarize pauvre_MODA [aw=hhweight] if t == 0 & D == 1 & `cond'
 15.         local a1 = r(mean)*100
 16.         quietly summarize pauvre_MODA [aw=hhweight] if t == 1 & D == 0 & `cond'
 17.         local b0 = r(mean)*100
 18.         quietly summarize pauvre_MODA [aw=hhweight] if t == 1 & D == 1 & `cond'
 19.         local b1 = r(mean)*100
 20.         local e0 = `a1' - `a0'
 21.         local e1 = `b1' - `b0'
 22.         quietly regress pauvre_MODA D if t == 0 & `cond', vce(cluster grappe)
 23.         local p0 = 2*ttail(e(df_r), abs(_b[D]/_se[D]))
 24.         quietly regress pauvre_MODA D if t == 1 & `cond', vce(cluster grappe)
 25.         local p1 = 2*ttail(e(df_r), abs(_b[D]/_se[D]))
 26.         quietly count if t == 0 & `cond'
 27.         local n0 = r(N)
 28.         quietly count if t == 1 & `cond'
 29.         di "  " %-10s "`slbl'" %9.1f `a0' %10.1f `a1' %8.1f `e0' " |" ///
>            %9.1f `b0' %10.1f `b1' %8.1f `e1' " |" %7.1f `e1'-`e0' ///
>            %7.3f `p0' %7.3f `p1' %9.0f `n0' %9.0f r(N)
 30.     }
 31. }


