. /* ============================================================
>    09_placebo_attrition.do - Tests de validite (annexe A)
> 
>    1. Test placebo : 200 assignations aleatoires d'un faux
>       traitement parmi les menages jamais traites ; la
>       distribution des ATT placebo doit etre centree sur zero
>       si l'hypothese de tendances paralleles est plausible.
>    2. Test d'attrition : comparaison des menages de l'EHCVM I
>       retrouves vs perdus en 2021 sur les covariables de base.
> 
>    Aucune ponderation par poids d'enquete.
>    ============================================================ */
. 
. 
. /* ============================================================
>    1. Test placebo (200 replications)
>    ============================================================ */
. 
. di _newline "=== Test placebo (200 replications) ==="

=== Test placebo (200 replications) ===

. 
. local n_rep 200

. matrix PLA = J(`n_rep', 1, .)   /* col 1 = MODA */

. 
. /* Echantillon : menages jamais traites uniquement */
. use "$TEMP/panel_vrai.dta", clear

. keep if D == 0
(7,529 observations deleted)

. tempfile never

. save `never'
file C:\Users\Bmd\AppData\Local\Temp\ST_5670_00000c.tmp saved as .dta format

. 
. /* Liste des menages (une ligne par menage) */
. bysort grappe menage: keep if _n == 1
(33,952 observations deleted)

. keep grappe menage

. tempfile liste_men

. save `liste_men'
file C:\Users\Bmd\AppData\Local\Temp\ST_5670_00000d.tmp saved as .dta format

. quietly count

. local n_men = r(N)

. /* part de faux traites = part observee de traites stables (~14.6%) */
. local part_fake = 681/4662

. 
. forvalues r = 1/`n_rep' {
  2.     quietly {
  3.         use `liste_men', clear
  4.         set seed `=1000+`r''
  5.         gen u = runiform()
  6.         sort u
  7.         gen byte fakeD = (_n <= `part_fake'*`n_men')
  8.         keep grappe menage fakeD
  9.         tempfile fake
 10.         save `fake'
 11. 
.         use `never', clear
 12.         merge m:1 grappe menage using `fake', keep(match) nogenerate
 13. 
.         /* DD placebo (moyennes des 4 cellules) */
.         foreach y in pauvre_MODA {
 14.             summarize `y' if t==1 & fakeD==1
 15.             local m11 = r(mean)
 16.             summarize `y' if t==0 & fakeD==1
 17.             local m01 = r(mean)
 18.             summarize `y' if t==1 & fakeD==0
 19.             local m10 = r(mean)
 20.             summarize `y' if t==0 & fakeD==0
 21.             local m00 = r(mean)
 22.             local att = (`m11'-`m01') - (`m10'-`m00')
 23.             matrix PLA[`r',1] = `att'
 24.         }
 25.     }
 26.     if mod(`r', 50) == 0 di "  replication `r'/`n_rep'"
 27. }
  replication 50/200
  replication 100/200
  replication 150/200
  replication 200/200

. 
. /* Statistiques de la distribution placebo */
. clear

. svmat PLA, names(col)
number of observations will be reset to 200
Press any key to continue, or Break to abort
Number of observations (_N) was 0, now 200.

. rename c1 att_moda

. foreach y in moda {
  2.     quietly summarize att_`y'
  3.     di _newline "Placebo `y' : moyenne=" %7.4f r(mean) "  sd=" %6.4f r(sd)
  4.     quietly count if abs(att_`y') > 0.05
  5.     di "  fraction |ATT|>0.05 : " %4.1f 100*r(N)/`n_rep' "%"
  6. }

