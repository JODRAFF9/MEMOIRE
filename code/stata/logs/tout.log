. di _newline "=== 4. Privation par dimension ==="

=== 4. Privation par dimension ===

. 
. foreach annee in 2018 2021 {
  2.     local tt = cond(`annee' == 2018, 0, 1)
  3.     use "$TEMP/panel_enfants_psm.dta", clear
  4.     keep if t == `tt'
  5.     di _newline "-- Dimensions `annee' --"
  6.     foreach dim in assai eau logem nutri sante protect educ {
  7.         quietly summarize dim_`dim' [aw=hhweight]
  8.         di "  `dim' : " %5.1f r(mean)*100 "%"
  9.     }
 10.     di _newline "  -- Dimensions `annee' par tranche d'age --"
 11.     foreach dim in assai eau logem nutri sante protect educ {
 12.         quietly tabstat dim_`dim' [aw=hhweight], by(groupe_base) ///
>             stat(mean n) format(%7.4f) save
 13.         forvalues g = 1/3 {
 14.             matrix M = r(Stat`g')
 15.             local lbl = cond(`g'==1,"0-4 ans",cond(`g'==2,"5-14 ans","15-17 ans"))
 16.             di "  `dim' / `lbl' : " %5.1f M[1,1]*100 "%   n=" %7.0f M[2,1]
 17.         }
 18.     }
 19.     /* ── Taux de privation PAR INDICATEUR ─────────────────────
>        La dimension agrege par la regle de l'union : le taux de la
>        dimension ne dit pas quel indicateur le porte. Chaque indicateur
>        est decrit sur son champ d'application (enfants pour lesquels il
>        n'est pas manquant), au total, par statut et par groupe d'age. */
.     di _newline "  -- Indicateurs `annee' : taux de privation --"
 20.     di "    indicateur        ensemble   benefic.   non-ben.       n"
 21.     foreach ind in m_toilet m_partag_toi m_eau_source m_eau_temps ///
>                    m_ordures m_surpeup m_securite m_combust ///
>                    m_sante_acces m_acte_nais m_trav_enf m_scol m_alfab {
 22.         quietly count if !missing(`ind')
 23.         local n_ind = r(N)
 24.         if `n_ind' > 0 {
 25.             quietly summarize `ind' [aw=hhweight]
 26.             local p_ens = 100*r(mean)
 27.             quietly summarize `ind' [aw=hhweight] if D == 1
 28.             local p_b = 100*r(mean)
 29.             quietly summarize `ind' [aw=hhweight] if D == 0
 30.             local p_nb = 100*r(mean)
 31.             di "    " %-16s "`ind'" %9.1f `p_ens' %11.1f `p_b' ///
>                %11.1f `p_nb' %9.0f `n_ind'
 32.         }
 33.     }
 34.     di _newline "  -- Indicateurs `annee' par groupe d'age --"
 35.     foreach ind in m_toilet m_partag_toi m_eau_source m_eau_temps ///
>                    m_ordures m_surpeup m_securite m_combust ///
>                    m_sante_acces m_acte_nais m_trav_enf m_scol m_alfab {
 36.         local ligne "    `ind' :"
 37.         forvalues g = 1/3 {
 38.             quietly summarize `ind' [aw=hhweight] if groupe_base == `g'
 39.             if r(N) > 0 local ligne "`ligne'  g`g'=`: display %5.1f 100*r(mean)'"
 40.         }
 41.         di "`ligne'"
 42.     }
 43. 
.     quietly summarize intensite_moda [aw=hhweight] if pauvre_MODA == 1
 44.     local A = r(mean)
 45.     quietly summarize pauvre_MODA [aw=hhweight]
 46.     di "  Indice ajuste `annee' : H=" %5.1f 100*r(mean) "%  A=" %5.1f 100*`A' ///
>        "%  M0=" %5.3f r(mean)*`A'
 47. }
