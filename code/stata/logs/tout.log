    ok fig_dim_5_14.pdf
    ok fig_dim_ensemble.pdf
    ok fig_distrib_dimensions.pdf
    ok fig_distrib_nbdep.pdf
    ok fig_effets_dim.pdf
    ok fig_evolution_ipm.pdf
    ok fig_placebo_dd.pdf
    ok fig_profil_statut.pdf

