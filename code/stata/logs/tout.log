  Indicateur          D=0 2018  D=1 2018   Ecart |  D=0 2021  D=1 2021   Ecart |     DD

. 
. foreach v in dim_assai dim_eau dim_logem dim_nutri dim_sante dim_protect ///
>              dim_educ pauvre_MODA {
  2.     quietly summarize `v' [aw=hhweight] if t == 0 & D == 0
  3.     local a0 = r(mean)*100
  4.     quietly summarize `v' [aw=hhweight] if t == 0 & D == 1
  5.     local a1 = r(mean)*100
  6.     quietly summarize `v' [aw=hhweight] if t == 1 & D == 0
  7.     local b0 = r(mean)*100
  8.     quietly summarize `v' [aw=hhweight] if t == 1 & D == 1
  9.     local b1 = r(mean)*100
 10.     local g0 = `a1' - `a0'      /* ecart benef - non benef en 2018 */
 11.     local g1 = `b1' - `b0'      /* ecart benef - non benef en 2021 */
 12.     local dd = `g1' - `g0'      /* evolution de l'ecart = DD descriptive */
 13.     di "  " %-18s "`v'" %9.1f `a0' %10.1f `a1' %8.1f `g0' " |" ///
>        %9.1f `b0' %10.1f `b1' %8.1f `g1' " |" %7.1f `dd'
 14. }
