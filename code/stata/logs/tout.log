. 
. /* Meme comparaison declinee par groupe d'age : chaque sous-section du
>    rapport confronte les dimensions et le statut de beneficiaire au sein
>    d'une tranche d'age. Le groupe est celui de la PERIODE DE BASE : sur un
>    panel d'enfants suivis, un decoupage sur l'age courant ferait changer les
>    sous-groupes de composition entre les deux editions et la comparaison ne
>    porterait plus sur les memes enfants. « 0-4 ans » se lit donc « age de 0 a
>    4 ans en 2018 », et ces enfants ont 3 a 7 ans en 2021 : dim_educ, nulle
>    par construction en 2018, devient applicable a une partie d'entre eux. */
. forvalues g = 1/3 {
  2.     if `g' == 1 local lbl "0-4 ans"
  3.     if `g' == 2 local lbl "5-14 ans"
  4.     if `g' == 3 local lbl "15-17 ans"
  5.     di _newline(2) "=== Privations par dimension et statut — `lbl' ==="
  6.     di "  Indicateur          D=0 2018  D=1 2018   Ecart |  D=0 2021  D=1 2021   Ecart |     DD    p18    p21"
  7.     foreach v in dim_assai dim_eau dim_logem dim_nutri dim_sante dim_protect ///
>                  dim_educ pauvre_MODA {
  8.         quietly summarize `v' [aw=hhweight] if t == 0 & D == 0 & groupe_base == `g'
  9.         local a0 = r(mean)*100
 10.         quietly summarize `v' [aw=hhweight] if t == 0 & D == 1 & groupe_base == `g'
 11.         local a1 = r(mean)*100
 12.         quietly summarize `v' [aw=hhweight] if t == 1 & D == 0 & groupe_base == `g'
 13.         local b0 = r(mean)*100
 14.         quietly summarize `v' [aw=hhweight] if t == 1 & D == 1 & groupe_base == `g'
 15.         local b1 = r(mean)*100
 16.         local g0 = `a1' - `a0'
 17.         local g1 = `b1' - `b0'
 18.         local dd = `g1' - `g0'
 19.         quietly regress `v' D if t == 0 & groupe_base == `g', vce(cluster grappe)
 20.         local p0 = 2*ttail(e(df_r), abs(_b[D]/_se[D]))
 21.         quietly regress `v' D if t == 1 & groupe_base == `g', vce(cluster grappe)
 22.         local p1 = 2*ttail(e(df_r), abs(_b[D]/_se[D]))
 23.         di "  " %-18s "`v'" %9.1f `a0' %10.1f `a1' %8.1f `g0' " |" ///
>            %9.1f `b0' %10.1f `b1' %8.1f `g1' " |" %7.1f `dd' ///
>            %7.3f `p0' %7.3f `p1'
 24.     }
 25.     quietly count if groupe_base == `g' & t == 0
 26.     local n18 = r(N)
 27.     quietly count if groupe_base == `g' & t == 1
 28.     di "  Effectifs : `n18' enfants en 2018, " r(N) " en 2021"
 29. }


