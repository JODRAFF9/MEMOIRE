  dim_logem    : b(D) = -0.0860   p = 0.0058
  dim_nutri    : b(D) = -0.0960   p = 0.0010
  dim_sante    : b(D) =  0.0037   p = 0.5368
  dim_protect  : b(D) = -0.0181   p = 0.3083
  dim_educ     : b(D) = -0.0367   p = 0.0129

. 
. drop m_parents18 m_parents21 chef_f_t urbain_t

