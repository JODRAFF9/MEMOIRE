  dim_nutri : ATT=  0.0690  SE= 0.0349  p=0.0482
  dim_sante : ATT=  0.0211  SE= 0.0118  p=0.0749
  dim_protect : ATT=  0.0386  SE= 0.0218  p=0.0775
