. local n_rep 200

. matrix PLA = J(`n_rep', 3, .)   /* une colonne par groupe d'age */

. 
. /* Echantillon : enfants suivis des menages jamais traites */
. use "$TEMP/panel_enfants_psm.dta", clear

. keep if D == 0
(4,472 observations deleted)

. tempfile never

. save `never'
file C:\Users\Bmd\AppData\Local\Temp\ST_4dd8_00001a.tmp saved as .dta format

. 
. /* Liste des menages (une ligne par menage) */
. bysort grappe menage: keep if _n == 1
(19,632 observations deleted)

. keep grappe menage

. tempfile liste_men

. save `liste_men'
file C:\Users\Bmd\AppData\Local\Temp\ST_4dd8_00001b.tmp saved as .dta format

. quietly count

. local n_men = r(N)

. /* part de faux traites = part observee de traites */
. preserve

.     use "$TEMP/panel_enfants_psm.dta", clear

.     keep if t == 0
(13,511 observations deleted)

.     bysort grappe menage: keep if _n == 1
(10,061 observations deleted)

.     quietly summarize D

.     local part_fake = r(mean)

. restore

. di "  Part de faux traites appliquee : " %6.4f `part_fake'
  Part de faux traites appliquee : 0.1542

. 
. forvalues r = 1/`n_rep' {
  2.     quietly {
  3.         use `liste_men', clear
  4.         set seed `=1000+`r''
  5.         gen u = runiform()
  6.         sort u
  7.         gen byte fakeD = (_n <= `part_fake'*`n_men')
  8.         keep grappe menage fakeD
  9.         tempfile fake
 10.         save `fake'
 11. 
.         use `never', clear
 12.         merge m:1 grappe menage using `fake', keep(match) nogenerate
 13. 
.         /* DD placebo (moyennes des 4 cellules), par groupe d'age,
>            comme l'estimation principale */
.         forvalues g = 1/3 {
 14.             summarize pauvre_MODA if t==1 & fakeD==1 & groupe_base==`g'
 15.             local m11 = r(mean)
 16.             summarize pauvre_MODA if t==0 & fakeD==1 & groupe_base==`g'
 17.             local m01 = r(mean)
 18.             summarize pauvre_MODA if t==1 & fakeD==0 & groupe_base==`g'
 19.             local m10 = r(mean)
 20.             summarize pauvre_MODA if t==0 & fakeD==0 & groupe_base==`g'
 21.             local m00 = r(mean)
 22.             matrix PLA[`r',`g'] = (`m11'-`m01') - (`m10'-`m00')
 23.         }
 24.     }
 25.     if mod(`r', 50) == 0 di "  replication `r'/`n_rep'"
 26. }
  replication 50/200
  replication 100/200
  replication 150/200
  replication 200/200

. 
. /* Statistiques de la distribution placebo, groupe par groupe : la
>    distribution doit etre centree sur zero, et l'ATT du groupe doit se
>    situer dans sa queue. */
. clear

. svmat PLA, names(col)
number of observations will be reset to 200
Press any key to continue, or Break to abort
Number of observations (_N) was 0, now 200.

. forvalues g = 1/3 {
  2.     rename c`g' att_g`g'
  3.     quietly summarize att_g`g'
  4.     di _newline "Placebo groupe `g' : moyenne=" %7.4f r(mean) "  sd=" %6.4f r(sd)
  5.     quietly count if !missing(att_g`g')
  6.     local ntot = r(N)
  7.     quietly count if att_g`g' < ${ATT_G`g'}
  8.     di "  ATT du groupe (" %6.4f ${ATT_G`g'} ") : rang = " ///
>        %4.1f 100*r(N)/`ntot' "e centile"
  9. }

Placebo groupe 1 : moyenne= 0.0028  sd=0.0347
  ATT du groupe (0.0648) : rang = 95.5e centile

Placebo groupe 2 : moyenne= 0.0018  sd=0.0262
  ATT du groupe (0.0671) : rang = 99.0e centile

Placebo groupe 3 : moyenne= 0.0006  sd=0.1022
  ATT du groupe (0.1190) : rang = 88.5e centile

. 
. /* ── Fig placebo : distribution des ATT placebo vs ATT reel ──
>    Verifie la plausibilite des tendances paralleles : la distribution
>    placebo doit etre centree sur zero et l'ATT reel doit se situer dans
>    sa queue. */
. set dp comma

. forvalues g = 1/3 {
  2.     local titg : label grp `g'
  3.     quietly histogram att_g`g', width(0.005) frequency ///
>         color(gs9) lcolor(white) ///
>         xline(0, lcolor(black) lpattern(solid)) ///
>         xline(`=${ATT_G`g'}', lcolor(orange) lpattern(dash) lwidth(medthick)) ///
>         xtitle("ATT placebo") ytitle("Réplications") ///
>         title("`titg'", size(medium)) ///
>         graphregion(color(white)) plotregion(color(white)) ///
>         name(pla`g', replace)
  4. }

. graph combine pla1 pla2 pla3, rows(1) graphregion(color(white))

. set dp period

. graph export "$OUTPUT/figures/fig_placebo_dd.pdf", replace
file code/stata/output/figures/fig_placebo_dd.pdf saved as PDF format

. graph drop pla1 pla2 pla3

. di ">>> fig_placebo_dd.pdf sauvegardé (trois panneaux, un par groupe)"
>>> fig_placebo_dd.pdf sauvegardé (trois panneaux, un par groupe)

. 
. di _newline ">>> 09_placebo.do termine."

>>> 09_placebo.do termine.

