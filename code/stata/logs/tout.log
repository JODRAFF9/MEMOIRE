. forvalues g = 0/3 {
  2.     if `g' == 0 local lbl "Ensemble 0-17 ans"
  3.     if `g' == 1 local lbl "0-4 ans"
  4.     if `g' == 2 local lbl "5-14 ans"
  5.     if `g' == 3 local lbl "15-17 ans"
  6.     if `g' == 0 local cond "1"
  7.     else        local cond "groupe_base == `g'"
  8.     di _newline(2) "=== Incidence MODA par quintile de montant — `lbl' ==="
  9.     di "  Groupe          H 2018   H 2021      DD       n18      n21"
 10.     quietly summarize pauvre_MODA [aw=hhweight] if t == 0 & D == 0 & `cond'
 11.     local r0 = r(mean)*100
 12.     quietly summarize pauvre_MODA [aw=hhweight] if t == 1 & D == 0 & `cond'
 13.     local r1 = r(mean)*100
 14.     quietly count if t == 0 & D == 0 & `cond'
 15.     local m0 = r(N)
 16.     quietly count if t == 1 & D == 0 & `cond'
 17.     di "  " %-14s "Non-benef." %8.1f `r0' %9.1f `r1' %8.1f `r1'-`r0' ///
>        %10.0f `m0' %9.0f r(N)
 18.     forvalues q = 1/5 {
 19.         quietly count if q5_montant == `q' & t == 0 & `cond'
 20.         local n0 = r(N)
 21.         if `n0' > 0 {
 22.             quietly summarize pauvre_MODA [aw=hhweight] if t == 0 & q5_montant == `q' & `cond'
 23.             local a0 = r(mean)*100
 24.             quietly summarize pauvre_MODA [aw=hhweight] if t == 1 & q5_montant == `q' & `cond'
 25.             local a1 = r(mean)*100
 26.             quietly count if t == 1 & q5_montant == `q' & `cond'
 27.             di "  " %-14s "Quintile `q'" %8.1f `a0' %9.1f `a1' ///
>                %8.1f (`a1'-`a0')-(`r1'-`r0') %10.0f `n0' %9.0f r(N)
 28.         }
 29.     }
 30. }


