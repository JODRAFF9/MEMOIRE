 17.     replace lbl = "Assainissement" if dm == "assai"
 18.     replace lbl = "Eau"            if dm == "eau"
 19.     replace lbl = "Logement"       if dm == "logem"
 20.     replace lbl = "Nutrition"      if dm == "nutri"
 21.     replace lbl = "Santé"          if dm == "sante"
 22.     replace lbl = "Protection"     if dm == "protect"
 23.     replace lbl = "Éducation"      if dm == "educ"
 24.     /* education non applicable aux 0-4 ans */
.     if "`g'" == "1" drop if dm == "educ"
 25.     sort ordre
 26.     gen pos  = _n
 27.     gen pos0 = pos - 0.19
 28.     gen pos1 = pos + 0.19
 29.     /* Etiquettes en toutes lettres, virgule decimale garantie */
.     gen str8 l0 = subinstr(string(dim_0, "%3.1f"), ".", ",", 1)
 30.     gen str8 l1 = subinstr(string(dim_1, "%3.1f"), ".", ",", 1)
