>    MODA. Ligne verticale placee apres la barre des 4 dimensions. */
. tempname distrib

. matrix `distrib' = J(8, 3, .)

. foreach annee in 2018 2021 {
  2.     local tt = cond(`annee' == 2018, 0, 1)
  3.     use "$TEMP/panel_enfants_psm.dta", clear
  4.     keep if t == `tt'
  5.     local col = cond(`annee' == 2018, 2, 3)
  6.     quietly count if !missing(nb_dep)
  7.     local n_tot = r(N)
  8.     forvalues d = 0/7 {
  9.         quietly count if nb_dep == `d' & !missing(nb_dep)
 10.         matrix `distrib'[`d' + 1, 1] = `d'
 11.         matrix `distrib'[`d' + 1, `col'] = r(N) / `n_tot' * 100
 12.     }
 13. }
