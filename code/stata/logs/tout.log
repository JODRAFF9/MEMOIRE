. quietly count

. local n_men = r(N)

. /* part de faux traites = part observee de traites (entrants) parmi les
>    menages du panel d'analyse, calculee dynamiquement */
. preserve

.     use "$TEMP/panel_vrai.dta", clear

.     keep if t == 0
(28,341 observations deleted)

