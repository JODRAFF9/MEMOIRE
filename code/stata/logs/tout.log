. use `ker_all', clear

. save "$TEMP/poids_kernel.dta", replace
file code/stata/temp/poids_kernel.dta saved

. 
. /* -- 2c. Caliper --------------------------------------------- */
. di _newline "=== Appariement Caliper (eps=$CALIPER, sans remise), par groupe d'age ==="

=== Appariement Caliper (eps=0.05, sans remise), par groupe d'age ===

. tempfile cal_all

. local premier = 1

. forvalues g = 1/3 {
  2.     use "$TEMP/pscore_t0.dta", clear
  3.     keep if grp_psm == `g'
  4.     di _newline "-- Groupe d'age `g' --"
  5.     psmatch2 D, pscore(pscore) caliper($CALIPER) noreplacement common
  6. 
.     di _newline "Balance avant/apres (SMD), caliper, groupe `g' :"
  7.     pstest `covbal', both
  8.     quietly _biaismoyen $BALVARS, treat(D) pond(_weight)
  9.     global BIAIS_caliper = ${BIAIS_caliper} + r(meanbias)*_N
 10.     global NOBS_caliper  = ${NOBS_caliper}  + _N
 11.     di "  Biais standardise moyen residuel, groupe `g' : " %5.2f r(meanbias) " %"
 12. 
.     rename _weight weight_caliper
 13.     keep enfid weight_caliper
 14.     if `premier' == 1 {
 15.         save `cal_all', replace
 16.         local premier = 0
 17.     }
 18.     else {
 19.         append using `cal_all'
 20.         save `cal_all', replace
 21.     }
 22. }
