  D=0 t=1 :  H =  0.586   A =  0.698   M0 =  0.409
  D=1 t=0 :  H =  0.378   A =  0.675   M0 =  0.255
  D=1 t=1 :  H =  0.337   A =  0.670   M0 =  0.226

