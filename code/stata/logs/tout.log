. /* Statistiques de la distribution placebo */
. clear

. svmat PLA, names(col)
number of observations will be reset to 200
Press any key to continue, or Break to abort
Number of observations (_N) was 0, now 200.

. rename c1 att_moda

. foreach y in moda {
  2.     quietly summarize att_`y'
  3.     di _newline "Placebo `y' : moyenne=" %7.4f r(mean) "  sd=" %6.4f r(sd)
  4.     quietly count if abs(att_`y') > 0.05
  5.     di "  fraction |ATT|>0.05 : " %4.1f 100*r(N)/`n_rep' "%"
  6.     /* Centile de l'ATT reel dans la distribution placebo (rang percentile) */
.     quietly count if !missing(att_`y')
  7.     local ntot = r(N)
  8.     quietly count if att_`y' < $ATT_REEL
  9.     di "  ATT reel (" %6.4f $ATT_REEL ") : rang = " %4.1f 100*r(N)/`ntot' "e centile"
 10. }

