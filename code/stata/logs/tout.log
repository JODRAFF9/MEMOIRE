. /* ============================================================
>    2bis. Caracteristiques des transferts etrangers recus :
>    motifs declares et montants annualises
> 
>    Source : module detail des transferts (une ligne par transfert).
>    Restreint aux transferts dont l'expediteur reside a l'etranger
>    (meme definition que le traitement D). Le montant annuel est
>    obtenu en multipliant le montant par envoi par la frequence
>    declaree (mois x12, trimestre x4, semestre x2, annee x1 ;
>    irregulier = montant deja declare sur 12 mois, x1), puis somme
>    au niveau menage sur l'ensemble de ses transferts etrangers.
>    ============================================================ */
. 
. di _newline "=== 2bis. Motifs et montants des transferts etrangers ==="

=== 2bis. Motifs et montants des transferts etrangers ===

. 
. foreach annee in 2018 2021 {
  2. 
.     if `annee' == 2018 {
  3.         local base      "$BASE_2018"
  4.         local fich_det  s13a_2
  5.         local v_lieu    s13aq14
  6.         local v_motif   s13aq15
  7.         local v_montant s13aq17a
  8.         local v_freq    s13aq17b
  9.     }
 10.     else {
 11.         local base      "$BASE_2021"
 12.         local fich_det  s13_2
 13.         local v_lieu    s13q19
 14.         local v_motif   s13q20
 15.         local v_montant s13q22a
 16.         local v_freq    s13q22b
 17.     }
 18. 
.     use "`base'/`fich_det'_me_sen`annee'.dta", clear
 19.     keep if `v_lieu' >= $CODE_ETRANGER_MIN & !missing(`v_lieu')
 20. 
.     quietly count
 21.     di _newline "-- `annee' : " r(N) " transferts etrangers --"
 22. 
.     di "  Repartition des motifs (%):"
 23.     tab `v_motif'
 24. 
.     /* Montant annualise par transfert */
.     gen double mult = .
 25.     replace mult = 12 if `v_freq' == 1   /* mois       */
 26.     replace mult = 4  if `v_freq' == 2   /* trimestre  */
 27.     replace mult = 2  if `v_freq' == 3   /* semestre   */
 28.     replace mult = 1  if `v_freq' == 4   /* annee      */
 29.     replace mult = 1  if `v_freq' == 5   /* irregulier : montant sur 12 mois */
 30.     gen double montant_annuel = `v_montant' * mult
 31. 
.     /* Somme au niveau menage */
.     collapse (sum) montant_annuel, by(grappe menage)
 32.     di "  Montant annuel recu par menage beneficiaire (FCFA) :"
 33.     summarize montant_annuel, detail
 34. }
