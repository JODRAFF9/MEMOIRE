. use `knn_all', clear

. save "$TEMP/pscore_knn.dta", replace
file code/stata/temp/pscore_knn.dta saved

. di _newline ">>> k-NN : " _N " enfants apparies (trois groupes empiles)"

>>> k-NN : 13511 enfants apparies (trois groupes empiles)

. 
. /* -- 2b. Kernel ---------------------------------------------- */
. di _newline "=== Appariement Kernel (Epanechnikov, h=0.06), par groupe d'age ==="

=== Appariement Kernel (Epanechnikov, h=0.06), par groupe d'age ===

. tempfile ker_all

. local premier = 1

. forvalues g = 1/3 {
  2.     use "$TEMP/pscore_t0.dta", clear
  3.     keep if grp_psm == `g'
  4.     di _newline "-- Groupe d'age `g' --"
  5.     psmatch2 D, pscore(pscore) kernel kerneltype(epan) bwidth(0.06) common
  6. 
.     di _newline "Balance avant/apres (SMD), kernel, groupe `g' :"
  7.     /* pstest estime un probit interne qui peut ne pas converger sur un
>        groupe a tres faible effectif (r(430)) : son tableau est purement
>        descriptif, l'echec ne doit pas interrompre le pipeline. Le biais
>        retenu pour departager les methodes est calcule par _biaismoyen,
>        independant de pstest. */
.     capture noisily pstest `covbal', both
  8.     if _rc di "  !! pstest non convergent sur ce groupe (r(" _rc ")) — ignore."
  9.     quietly _biaismoyen $BALVARS, treat(D) pond(_weight)
 10.     global BIAIS_kernel = ${BIAIS_kernel} + r(meanbias)*_N
 11.     global NOBS_kernel  = ${NOBS_kernel}  + _N
 12.     di "  Biais standardise moyen residuel, groupe `g' : " %5.2f r(meanbias) " %"
 13. 
.     rename _weight weight_kernel
 14.     keep enfid weight_kernel
 15.     if `premier' == 1 {
 16.         save `ker_all', replace
 17.         local premier = 0
 18.     }
 19.     else {
 20.         append using `ker_all'
 21.         save `ker_all', replace
 22.     }
 23. }
