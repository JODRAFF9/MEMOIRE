  7.         /* n_calc = enfants avec un statut N-MODA calcule ; n_tot = effectif
>            total de la tranche (colonne "Obs." du tableau du rapport) */
.         local nobs  = r(N)
  8.         quietly count if groupe_moda == `g'
  9.         local ntot  = r(N)
 10.         local lbl   = cond(`g'==1,"0-4 ans",cond(`g'==2,"5-14 ans","15-17 ans"))
 11.         di "  `annee' / `lbl' : H=" %5.1f `hmoda' "% (n_calc=`nobs', n_tot=`ntot')"
 12.     }
 13. }
