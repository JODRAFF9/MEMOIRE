. foreach ind in m_toilet m_partag_toi m_eau_source m_eau_temps ///
>                m_ordures m_surpeup m_securite m_combust m_sante_acces ///
>                m_acte_nais m_trav_enf m_scol m_alfab {
  2.     quietly count if !missing(`ind')
  3.     local n_ind = r(N)
  4.     if `n_ind' > 0 {
  5.         quietly regress `ind' i.D [aw=$POIDS_PRINCIPAL], vce(cluster grappe)
  6.         di "  " %-16s "`ind'" %8.0f `n_ind' %10.4f _b[1.D] ///
>            %9.4f _se[1.D] %9.4f 2*ttail(e(df_r), abs(_b[1.D]/_se[1.D]))
  7.     }
  8.     else {
  9.         di "  " %-16s "`ind'" "   non renseigne sur le panel"
 10.     }
 11. }
