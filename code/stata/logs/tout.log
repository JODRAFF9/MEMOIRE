. /* ============================================================
>    SECTION : 09_PLACEBO — Tests de validite (annexe A)
> 
>    1. Test placebo : 200 assignations aleatoires d'un faux
>       traitement parmi les menages jamais traites ; la
>       distribution des ATT placebo doit etre centree sur zero
>       si l'hypothese de tendances paralleles est plausible.
>       retrouves vs perdus en 2021 sur les covariables de base.
> 
>    Aucune ponderation par poids d'enquete.
>    ============================================================ */
. 
. 
. /* ============================================================
>    1. Test placebo (200 replications)
>    ============================================================ */
. 
. di _newline "=== Test placebo (200 replications) ==="

=== Test placebo (200 replications) ===

. 
. local n_rep 200

. matrix PLA = J(`n_rep', 1, .)   /* col 1 = MODA */

. 
. /* Echantillon : enfants suivis des menages jamais traites */
. use "$TEMP/panel_enfants_psm.dta", clear

. keep if D == 0
(5,276 observations deleted)

. tempfile never

. save `never'
file C:\Users\Bmd\AppData\Local\Temp\ST_4b20_00001c.tmp saved as .dta format

. 
. /* Liste des menages (une ligne par menage) */
. bysort grappe menage: keep if _n == 1
(26,330 observations deleted)

. keep grappe menage

. tempfile liste_men

. save `liste_men'
file C:\Users\Bmd\AppData\Local\Temp\ST_4b20_00001d.tmp saved as .dta format

. quietly count

. local n_men = r(N)

. /* part de faux traites = part observee de traites */
. preserve

.     use "$TEMP/panel_enfants_psm.dta", clear

.     keep if t == 0
(17,786 observations deleted)

.     bysort grappe menage: keep if _n == 1
(13,209 observations deleted)

.     quietly summarize D

.     local part_fake = r(mean)

. restore

. di "  Part de faux traites appliquee : " %6.4f `part_fake'
  Part de faux traites appliquee : 0.1335

. 
. forvalues r = 1/`n_rep' {
  2.     quietly {
  3.         use `liste_men', clear
  4.         set seed `=1000+`r''
  5.         gen u = runiform()
  6.         sort u
  7.         gen byte fakeD = (_n <= `part_fake'*`n_men')
  8.         keep grappe menage fakeD
  9.         tempfile fake
 10.         save `fake'
 11. 
.         use `never', clear
 12.         merge m:1 grappe menage using `fake', keep(match) nogenerate
 13. 
.         /* DD placebo (moyennes des 4 cellules) */
.         foreach y in pauvre_MODA {
 14.             summarize `y' if t==1 & fakeD==1
 15.             local m11 = r(mean)
 16.             summarize `y' if t==0 & fakeD==1
 17.             local m01 = r(mean)
 18.             summarize `y' if t==1 & fakeD==0
 19.             local m10 = r(mean)
 20.             summarize `y' if t==0 & fakeD==0
 21.             local m00 = r(mean)
 22.             local att = (`m11'-`m01') - (`m10'-`m00')
 23.             matrix PLA[`r',1] = `att'
 24.         }
 25.     }
 26.     if mod(`r', 50) == 0 di "  replication `r'/`n_rep'"
 27. }
  replication 50/200
  replication 100/200
  replication 150/200
  replication 200/200

