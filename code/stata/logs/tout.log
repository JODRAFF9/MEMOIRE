. /* ============================================================
>    SECTION : 06_STATS_DESC — Statistiques descriptives
>    Chapitre 3 : profil ménages, pauvreté, privations, comparaison D=0/1
> 
>    Les statistiques portant sur les ENFANTS sont calculees sur les enfants
>    suivis individuellement d'une vague a l'autre (panel_enfants_psm.dta),
>    c'est-a-dire sur l'echantillon meme de l'estimation d'impact avant la
>    restriction au support commun. Un tableau descriptif et un coefficient
>    estime decrivent ainsi les memes enfants. Le profil des MENAGES (bloc 1)
>    reste sur le panel vrai, son unite etant le menage et non l'enfant.
> 
>    Les statistiques de pauvrete/privation (incidence MODA, par dimension,
>    par age, par milieu, par region) sont PONDEREES par les poids de sondage
>    (hhweight). Le profil des menages et la balance traites/non-traites
>    restent sur effectifs bruts.
>    ============================================================ */
. 
. 
. /* Créer les dossiers de sortie */
. capture mkdir "$OUTPUT"

. capture mkdir "$OUTPUT/figures"

. capture mkdir "$OUTPUT/tables"

. 
. /* ============================================================
>    1. Caractéristiques générales des ménages
>    ============================================================ */
. 
. di _newline "=== 1. Profil des ménages ==="

=== 1. Profil des ménages ===

. 
. foreach annee in 2018 2021 {
  2.     local tt = cond(`annee' == 2018, 0, 1)
  3.     use "$TEMP/panel_vrai.dta", clear
  4.     keep if t == `tt'
  5.     bysort grappe menage: keep if _n == 1   /* un ménage = une ligne */
  6. 
.     drop D
  7.     merge m:1 grappe menage using "$TEMP/traitement_`annee'.dta", ///
>         keepusing(D) nogenerate keep(master match)
  8.     replace D = 0 if missing(D)
  9. 
.     /* Taille ménage, âge CM, milieu, transferts */
.     quietly {
 10.         gen byte chef_f = (hgender == 2)
 11.         gen byte urbain = (milieu == 1)
 12.         foreach v in hhsize hage pcexp chef_f urbain D {
 13.             summarize `v' [aw=hhweight]   /* caracteristiques ponderees (representativite nationale) */
 14.             if "`v'" == "hhsize" scalar m_hhsize_`annee' = r(mean)
 15.             if "`v'" == "hage"   scalar m_hage_`annee'   = r(mean)
 16.             if "`v'" == "pcexp"  scalar m_pcexp_`annee'  = r(mean)
 17.             if "`v'" == "chef_f" scalar p_chef_f_`annee' = r(mean)*100
 18.             if "`v'" == "urbain" scalar p_urbain_`annee' = r(mean)*100
 19.             if "`v'" == "D"      scalar p_D_`annee'      = r(mean)*100
 20.         }
 21.         count
 22.         scalar n_men_`annee' = r(N)
 23.     }
 24.     di "`annee' : " n_men_`annee' " ménages"
 25.     di "  Taille moy : " %5.2f m_hhsize_`annee'
 26.     di "  PCE moy    : " %12.0f m_pcexp_`annee' " FCFA/an"
 27.     di "  Chef féminin  : " %5.1f p_chef_f_`annee' "%"
 28.     di "  Milieu urbain : " %5.1f p_urbain_`annee' "%"
 29.     di "  Transferts    : " %5.1f p_D_`annee'      "%"
 30. }
