(1 missing value generated)

. replace benef   = dd_b1 in 2
(1 real change made)

. gen temoin  = dd_c0 in 1
(1 missing value generated)

. replace temoin  = dd_c1 in 2
(1 real change made)

. gen contref = dd_b0 in 1
(1 missing value generated)

. replace contref = dd_cf1 in 2
(1 real change made)

. gen str8 lb_b = subinstr(string(benef,  "%3.1f"), ".", ",", 1) + " %"

