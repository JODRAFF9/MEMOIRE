. /* ── Fig : taux de privation par dimension, ensemble et par groupe ──
>    Barres horizontales, une paire par dimension (EHCVM I vs II),
>    ponderees par hhweight. Remplace les tableaux du chapitre 3. */
. use "$TEMP/panel_enfants_psm.dta", clear

. foreach g in ens 1 2 3 {
  2.     preserve
  3.     if "`g'" != "ens" keep if groupe_base == `g'
  4.     collapse (mean) dim_assai dim_eau dim_logem dim_nutri dim_sante ///
>              dim_protect dim_educ [aw=hhweight], by(t)
  5.     reshape long dim_, i(t) j(dm) string
  6.     replace dim_ = 100*dim_
  7.     reshape wide dim_, i(dm) j(t)
  8.     gen byte ordre = .
  9.     replace ordre = 1 if dm == "assai"
 10.     replace ordre = 2 if dm == "eau"
 11.     replace ordre = 3 if dm == "logem"
 12.     replace ordre = 4 if dm == "nutri"
 13.     replace ordre = 5 if dm == "sante"
 14.     replace ordre = 6 if dm == "protect"
 15.     replace ordre = 7 if dm == "educ"
 16.     gen str22 lbl = ""
 17.     replace lbl = "Assainissement" if dm == "assai"
 18.     replace lbl = "Eau"            if dm == "eau"
 19.     replace lbl = "Logement"       if dm == "logem"
 20.     replace lbl = "Nutrition"      if dm == "nutri"
 21.     replace lbl = "Santé"          if dm == "sante"
 22.     replace lbl = "Protection"     if dm == "protect"
 23.     replace lbl = "Éducation"      if dm == "educ"
 24.     /* education non applicable aux 0-4 ans */
.     if "`g'" == "1" drop if dm == "educ"
 25.     sort ordre
 26.     gen pos  = _n
 27.     gen pos0 = pos - 0.19
 28.     gen pos1 = pos + 0.19
 29.     /* Etiquettes en toutes lettres, virgule decimale garantie */
.     gen str8 l0 = subinstr(string(dim_0, "%3.1f"), ".", ",", 1)
 30.     gen str8 l1 = subinstr(string(dim_1, "%3.1f"), ".", ",", 1)
 31.     local ylab ""
 32.     forvalues i = 1/`=_N' {
 33.         local ylab `ylab' `i' "`=lbl[`i']'"
 34.     }
 35.     twoway (bar dim_0 pos0, horizontal barwidth(0.36) color(gs9)) ///
>            (bar dim_1 pos1, horizontal barwidth(0.36) color(orange)) ///
>            (scatter pos0 dim_0, msymbol(none) mlabel(l0) ///
>                 mlabcolor(black) mlabsize(vsmall) mlabpos(3)) ///
>            (scatter pos1 dim_1, msymbol(none) mlabel(l1) ///
>                 mlabcolor(black) mlabsize(vsmall) mlabpos(3)), ///
>         ylabel(`ylab', angle(0) nogrid) yscale(reverse) ytitle("") ///
>         xlabel(0(20)100, grid) xtitle("Taux de privation (%)") ///
>         legend(order(1 "EHCVM I (2018-19)" 2 "EHCVM II (2021-22)") ///
>                pos(6) rows(1) region(color(white))) ///
>         graphregion(color(white)) plotregion(color(white))
 36.     local suf = cond("`g'"=="ens","ensemble", ///
>         cond("`g'"=="1","0_4", cond("`g'"=="2","5_14","15_17")))
 37.     graph export "$OUTPUT/figures/fig_dim_`suf'.pdf", replace
 38.     di ">>> fig_dim_`suf'.pdf sauvegardé"
 39.     restore
 40. }
