. use `ker_all', clear

. save "$TEMP/poids_kernel.dta", replace
file code/stata/temp/poids_kernel.dta saved

. 
. /* -- 2c. Caliper --------------------------------------------- */
. di _newline "=== Appariement Caliper (eps=$CALIPER, sans remise), par groupe d'age ==="

=== Appariement Caliper (eps=0.05, sans remise), par groupe d'age ===

. tempfile cal_all

. local premier = 1

. forvalues g = 1/3 {
  2.     use "$TEMP/pscore_t0.dta", clear
  3.     keep if grp_psm == `g'
  4.     di _newline "-- Groupe d'age `g' --"
  5.     psmatch2 D, pscore(pscore) caliper($CALIPER) noreplacement common
  6. 
.     di _newline "Balance avant/apres (SMD), caliper, groupe `g' :"
  7.     /* pstest estime un probit interne qui peut ne pas converger sur un
>        groupe a tres faible effectif (r(430)) : son tableau est purement
>        descriptif, l'echec ne doit pas interrompre le pipeline. Le biais
>        retenu pour departager les methodes est calcule par _biaismoyen,
>        independant de pstest. */
.     capture noisily pstest `covbal', both
  8.     if _rc di "  !! pstest non convergent sur ce groupe (r(" _rc ")) — ignore."
  9.     quietly _biaismoyen $BALVARS, treat(D) pond(_weight)
 10.     global BIAIS_caliper = ${BIAIS_caliper} + r(meanbias)*_N
 11.     global NOBS_caliper  = ${NOBS_caliper}  + _N
 12.     di "  Biais standardise moyen residuel, groupe `g' : " %5.2f r(meanbias) " %"
 13. 
.     rename _weight weight_caliper
 14.     keep enfid weight_caliper
 15.     if `premier' == 1 {
 16.         save `cal_all', replace
 17.         local premier = 0
 18.     }
 19.     else {
 20.         append using `cal_all'
 21.         save `cal_all', replace
 22.     }
 23. }
